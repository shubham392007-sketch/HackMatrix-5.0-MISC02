APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-in-production-secret-key-32chars-min

# Supabase
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence-originals
SUPABASE_DERIVATIVES_BUCKET=evidence-derivatives

# Encryption Key for Connector Credentials (Fernet 32-byte urlsafe base64)
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Ollama Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_QWEN_MODEL=qwen3:8b
OLLAMA_OCR_MODEL=glm-ocr
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Security & CORS
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_SIZE_MB=25
EVIDENCE_PROCESSING_CONCURRENCY=1
