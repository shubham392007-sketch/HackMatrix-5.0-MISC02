# ==============================================================================
# Skill Passport — Unified Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   1. backend/.env          (Backend FastAPI runtime)
#   2. .env.local            (Frontend Next.js runtime in project root)
#
# IMPORTANT: Never commit files containing live secrets, private keys, or tokens.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (.env.local)
# ------------------------------------------------------------------------------
# Public Supabase project URL (must match backend SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon / Client API Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Direct backend API target URL used by server-side requests and documentation links
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8001

# Base URL prefix for frontend API client proxy routes (defaults to /api/v1 rewrite)
NEXT_PUBLIC_API_URL=/api/v1


# ------------------------------------------------------------------------------
# 2. BACKEND SERVER & SECURITY (backend/.env)
# ------------------------------------------------------------------------------
# Application Environment: development | staging | production
APP_ENV=development

# API Version prefix
API_V1_PREFIX=/api/v1

# Internal server secret key (minimum 32 characters for HMAC / session signing)
SECRET_KEY=change-in-production-secret-key-32chars-min

# Fernet symmetric encryption key for storing external tokens (GitHub PATs, Jira tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here=

# Allowed CORS origins (comma-separated, wildcards allowed in development)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001


# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL via Supabase)
# ------------------------------------------------------------------------------
# Primary application connection string (uses psycopg2 driver).
# If using Supabase Connection Pooler (Transaction Mode, port 6543):
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Direct connection string for schema migrations and Alembic (Session Mode, port 5432):
DIRECT_URL=postgresql+psycopg2://postgres.your-project-ref:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Connection Pool Tuning (enforces <= 8 connections to stay within Supabase micro tier 15-conn limit)
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=20.0
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=True

# Database Circuit Breaker & Retry Settings
DB_MAX_RETRIES=2
DB_CIRCUIT_BREAKER_THRESHOLD=5
DB_CIRCUIT_BREAKER_RECOVERY_SECONDS=15.0


# ------------------------------------------------------------------------------
# 4. SUPABASE SERVICE & STORAGE (backend/.env)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Supabase Service Role Key (BYPASSES RLS - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET=evidence-originals
SUPABASE_DERIVATIVES_BUCKET=evidence-derivatives


# ------------------------------------------------------------------------------
# 5. OLLAMA & LOCAL AI INFERENCE (backend/.env)
# ------------------------------------------------------------------------------
# Ollama service endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Primary LLM for work analysis, skill extraction, and JSON reasoning
OLLAMA_QWEN_MODEL=qwen3:8b

# OCR model for image/scanned document extraction
OLLAMA_OCR_MODEL=glm-ocr

# Local embedding model for semantic vector search
OLLAMA_EMBED_MODEL=nomic-embed-text

# Inference HTTP timeout in seconds (allows for cold model loading on local GPU/CPU)
OLLAMA_TIMEOUT_SECONDS=180.0

# Context window size in tokens (8192 provides balanced memory for 6GB-8GB VRAM)
OLLAMA_NUM_CTX=8192


# ------------------------------------------------------------------------------
# 6. VECTOR STORAGE & RAG (backend/.env)
# ------------------------------------------------------------------------------
# Directory path for ChromaDB persistent vector index
CHROMA_PERSIST_DIRECTORY=./chroma_data


# ------------------------------------------------------------------------------
# 7. ASYNCHRONOUS TASKS & QUEUES (backend/.env)
# ------------------------------------------------------------------------------
# Redis connection URL for Celery worker (optional; in-memory fallback is active if unavailable)
REDIS_URL=redis://localhost:6379/0

# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=25

# Number of concurrent evidence extraction tasks per worker
EVIDENCE_PROCESSING_CONCURRENCY=1
